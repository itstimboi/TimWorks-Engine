#include "glfwstuff.h"

#include <cstdint>
#include <cstdio>
#include <cstring>

#include <glad/glad46.h>

// ============================================================
// GLFW 3
// ============================================================

#if defined(__MINGW64__)

    #define GLFW_INCLUDE_NONE
    #include <GLFW/glfw3.h>

#endif


// ============================================================
// GLFW 2
// ============================================================

#if defined(__MINGW32__) && !defined(__MINGW64__)

    #include <GLFW/glfw2.h>

#endif


namespace TWE
{

// ============================================================
// Internal State
// ============================================================

static GLFWBackend activeBackend = GLFWBackend::None;
static bool initialized = false;


// ============================================================
// Backend Selection
// ============================================================

GLFWBackend GetGLFWBackend()
{
    #if defined(__MINGW64__)

        return GLFWBackend::GLFW3;

    #elif defined(__MINGW32__)

        return GLFWBackend::GLFW2;

    #else

        return GLFWBackend::None;

    #endif
}


// ============================================================
// Initialize
// ============================================================

bool InitializeGLFWBackend()
{
    if (initialized)
        return true;

    activeBackend = GetGLFWBackend();

    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (glfwInit() != GLFW_TRUE)
        {
            std::fprintf(
                stderr,
                "TimWorks Engine: Failed to initialize GLFW3.\n"
            );

            activeBackend = GLFWBackend::None;

            return false;
        }

        initialized = true;

        return true;

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        if (glfw2Init() != GL_TRUE)
        {
            std::fprintf(
                stderr,
                "TimWorks Engine: Failed to initialize GLFW2.\n"
            );

            activeBackend = GLFWBackend::None;

            return false;
        }

        initialized = true;

        return true;

    #else

        activeBackend = GLFWBackend::None;

        return false;

    #endif
}


// ============================================================
// Shutdown
// ============================================================

void ShutdownGLFWBackend()
{
    if (!initialized)
        return;

    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        glfwTerminate();

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        glfw2Terminate();

    #endif

    activeBackend = GLFWBackend::None;
    initialized = false;
}


// ============================================================
// Set OpenGL Version
// ============================================================

bool SetGLFWOpenGLVersion(int major, int minor)
{
    if (!initialized)
        return false;

    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        glfwDefaultWindowHints();

        glfwWindowHint(
            GLFW_CONTEXT_VERSION_MAJOR,
            major
        );

        glfwWindowHint(
            GLFW_CONTEXT_VERSION_MINOR,
            minor
        );

        glfwWindowHint(
            GLFW_OPENGL_PROFILE,
            GLFW_OPENGL_ANY_PROFILE
        );

        return true;

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        /*
            GLFW2 does not natively expose the GLFW3 context
            version API.

            If your modified GLFW2 contains these functions,
            they can be used here.
        */

        #ifdef GLFW2_VERSION_MAJOR
            glfw2OpenWindowHint(
                GLFW2_VERSION_MAJOR,
                major
            );
        #endif

        #ifdef GLFW2_VERSION_MINOR
            glfw2OpenWindowHint(
                GLFW2_VERSION_MINOR,
                minor
            );
        #endif

        return true;

    #else

        return false;

    #endif
}


// ============================================================
// Create Window
// ============================================================

void* CreateGLFWWindow(
    int width,
    int height,
    const char* title,
    bool fullscreen,
    bool visible
)
{
    if (!initialized)
        return nullptr;

    if (!title)
        title = "TimWorks Engine Window";


    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        glfwDefaultWindowHints();

        glfwWindowHint(
            GLFW_VISIBLE,
            visible ? GLFW_TRUE : GLFW_FALSE
        );

        GLFWwindow* window =
            glfwCreateWindow(
                width,
                height,
                title,
                fullscreen ? glfwGetPrimaryMonitor() : nullptr,
                nullptr
            );

        if (!window)
        {
            std::fprintf(
                stderr,
                "TimWorks Engine: GLFW3 failed to create window.\n"
            );

            return nullptr;
        }

        glfwMakeContextCurrent(window);

        return static_cast<void*>(window);


    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        /*
            GLFW2 has a single global window/context.
        */

        int flags = GLFW2_WINDOW;

        if (fullscreen)
            flags |= GLFW2_FULLSCREEN;

        /*
            GLFW2 does not have the same visibility mechanism
            as GLFW3.

            If your modified GLFW2 supports a hidden-window
            flag, add it here.
        */

        (void)visible;

        if (!glfw2OpenWindow(
                width,
                height,
                8,
                8,
                8,
                8,
                24,
                8,
                flags))
        {
            std::fprintf(
                stderr,
                "TimWorks Engine: GLFW2 failed to create window.\n"
            );

            return nullptr;
        }

        glfw2SetWindowTitle(title);

        /*
            GLFW2 owns the actual window globally.

            Return a non-null token so the TimWorks Engine API
            can still use a void* window handle.
        */

        return reinterpret_cast<void*>(
            static_cast<uintptr_t>(1)
        );


    #else

        (void)width;
        (void)height;
        (void)title;
        (void)fullscreen;
        (void)visible;

        return nullptr;

    #endif
}


// ============================================================
// Destroy Window
// ============================================================

void DestroyGLFWWindow(void* window)
{
    if (!window)
        return;

    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwDestroyWindow(glfwWindow);

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        glfw2CloseWindow();

    #endif
}


// ============================================================
// Make Context Current
// ============================================================

void MakeGLFWContextCurrent(void* window)
{
    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwMakeContextCurrent(glfwWindow);

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        /*
            GLFW2 owns one global OpenGL context.
        */

        (void)window;

    #else

        (void)window;

    #endif
}


// ============================================================
// Swap Buffers
// ============================================================

void SwapGLFWBuffers(void* window)
{
    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwSwapBuffers(glfwWindow);

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        glfw2SwapBuffers();

    #else

        (void)window;

    #endif
}


// ============================================================
// Window Should Close
// ============================================================

bool GLFWWindowShouldClose(void* window)
{
    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return true;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        return glfwWindowShouldClose(glfwWindow)
            != GLFW_FALSE;

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        return glfw2GetWindowParam(GLFW2_OPENED)
            == GL_FALSE;

    #else

        (void)window;

        return true;

    #endif
}


// ============================================================
// Poll Events
// ============================================================

void PollGLFWEvents()
{
    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        glfwPollEvents();

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        /*
            Your renamed GLFW2 library can expose this if you
            add it.

            glfw2PollEvents();
        */

    #endif
}


// ============================================================
// Set Window Title
// ============================================================

void SetGLFWWindowTitle(
    void* window,
    const char* title
)
{
    if (!title)
        return;

    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwSetWindowTitle(
            glfwWindow,
            title
        );

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        glfw2SetWindowTitle(title);

    #else

        (void)window;

    #endif
}


// ============================================================
// Set Window Size
// ============================================================

void SetGLFWWindowSize(
    void* window,
    int width,
    int height
)
{
    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwSetWindowSize(
            glfwWindow,
            width,
            height
        );

    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        glfw2SetWindowSize(
            width,
            height
        );

    #else

        (void)window;
        (void)width;
        (void)height;

    #endif
}


// ============================================================
// Get Window Size
// ============================================================

bool GetGLFWWindowSize(
    void* window,
    int* width,
    int* height
)
{
    if (!width || !height)
        return false;


    // ========================================================
    // GLFW 3
    // ========================================================

    #if defined(__MINGW64__)

        if (!window)
            return false;

        GLFWwindow* glfwWindow =
            static_cast<GLFWwindow*>(window);

        glfwGetWindowSize(
            glfwWindow,
            width,
            height
        );

        return true;


    // ========================================================
    // GLFW 2
    // ========================================================

    #elif defined(__MINGW32__)

        (void)window;

        *width =
            glfw2GetWindowParam(GLFW2_WINDOW_WIDTH);

        *height =
            glfw2GetWindowParam(GLFW2_WINDOW_HEIGHT);

        return true;


    #else

        (void)window;

        *width = 0;
        *height = 0;

        return false;

    #endif
}


// ============================================================
// OpenGL Version String
// ============================================================

const char* GetGLVersionString()
{
    const GLubyte* version =
        glGetString(GL_VERSION);

    if (!version)
        return nullptr;

    return reinterpret_cast<const char*>(version);
}


} // namespace TWE